# =============================================================================
# DevFlow — Environment Variables Template
# =============================================================================
#
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your actual values in .env
#   3. NEVER commit your .env file (it is in .gitignore)
#   4. This file (.env.example) IS safe to commit — it has no real secrets
#
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# General settings for the application runtime environment.
# -----------------------------------------------------------------------------
APP_NAME=DevFlow
APP_ENV=development          # Options: development | staging | production
APP_DEBUG=true
APP_PORT=8000
APP_SECRET_KEY=replace-with-a-long-random-secret-key

# Backend config.py expected key
SECRET_KEY=replace-with-a-long-random-secret-key


# -----------------------------------------------------------------------------
# Frontend
# Configuration for the React development server.
# -----------------------------------------------------------------------------
VITE_APP_API_URL=http://localhost:8000
VITE_APP_ENV=development


# -----------------------------------------------------------------------------
# Database — PostgreSQL
# Connection details for the PostgreSQL database.
# In production this will point to AWS RDS.
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=devflow_db
POSTGRES_USER=devflow_user
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://devflow_user:replace-with-a-strong-password@localhost:5432/devflow_db

# Optional: Dedicated database for automated test suite (e.g. SQLite or PostgreSQL test db)
# DEVFLOW_TEST_DATABASE_URL=sqlite:///./test_devflow.db


# -----------------------------------------------------------------------------
# Cache — Redis
# Used for session management and background task queuing (planned).
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-strong-password
REDIS_URL=redis://:replace-with-a-strong-password@localhost:6379/0


# -----------------------------------------------------------------------------
# AWS — Cloud Infrastructure
# NEVER put real AWS credentials here.
# In CI/CD these are set as GitHub Actions secrets.
# Locally, use AWS CLI profiles or IAM roles instead of hardcoded keys.
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_ACCOUNT_ID=123456789012
AWS_ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com


# -----------------------------------------------------------------------------
# Docker / Container Registry
# Image names and tags for container builds.
# -----------------------------------------------------------------------------
DOCKER_IMAGE_FRONTEND=devflow-frontend
DOCKER_IMAGE_BACKEND=devflow-backend
DOCKER_TAG=latest


# -----------------------------------------------------------------------------
# GitHub Actions / CI/CD
# These are set as repository secrets in GitHub — never stored in files.
# Listed here for documentation purposes only.
# -----------------------------------------------------------------------------
# GITHUB_TOKEN=                    # Set automatically by GitHub Actions
# GH_DEPLOY_KEY=                   # SSH deploy key for private repo access


# -----------------------------------------------------------------------------
# Monitoring & Observability (Planned)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO                    # Options: DEBUG | INFO | WARNING | ERROR
SENTRY_DSN=replace-with-your-sentry-dsn

# -----------------------------------------------------------------------------
# GitHub OAuth & Webhooks
# Register your app at https://github.com/settings/developers
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=replace-with-your-github-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-client-secret
GITHUB_WEBHOOK_SECRET=replace-with-your-github-webhook-secret

# -----------------------------------------------------------------------------
# CORS
# Comma-separated list of allowed origins for the API.
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
