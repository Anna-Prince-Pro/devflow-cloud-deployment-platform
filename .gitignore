# =============================================================================
# DevFlow — .gitignore
# =============================================================================
# This file tells Git which files and directories to never track.
# Rule of thumb: ignore anything that is auto-generated, machine-specific,
# or contains secrets — anything a developer can recreate on their own machine.
# =============================================================================


# -----------------------------------------------------------------------------
# Python — Virtual Environments
# A virtual environment is a local copy of Python + installed packages.
# It is machine-specific and must never be committed.
# -----------------------------------------------------------------------------
venv/
.venv/
env/
.env_python/
__pyenv__/
*.egg-info/
dist/
build/
site-packages/

# -----------------------------------------------------------------------------
# Python — Cache & Compiled Files
# Python generates these automatically when running code.
# They are machine-specific and not needed in version control.
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg

# -----------------------------------------------------------------------------
# Node.js / Frontend
# node_modules contains all npm/yarn/pnpm installed packages.
# It can be hundreds of MB and must always be re-installed from package.json.
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# -----------------------------------------------------------------------------
# Frontend Build Output
# These are generated by the build process (e.g., `npm run build`).
# They should be produced by CI/CD, not committed to the repo.
# -----------------------------------------------------------------------------
frontend/dist/
frontend/build/
frontend/.next/
frontend/out/
frontend/.turbo/
*.tsbuildinfo

# -----------------------------------------------------------------------------
# Environment & Secret Files
# NEVER commit real credentials, API keys, passwords, or tokens.
# .env.example IS committed (it's a safe template with no real values).
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.development
secrets/
*.pem
*.key
*.p12
*.pfx

# -----------------------------------------------------------------------------
# Logs
# Log files grow over time and are environment-specific.
# -----------------------------------------------------------------------------
*.log
logs/
*.log.*
pip-log.txt

# -----------------------------------------------------------------------------
# Terraform
# State files contain your real infrastructure details (IPs, resource IDs).
# They can contain sensitive data and should use remote state (e.g., S3).
# .terraform/ is a local plugin cache — regenerated by `terraform init`.
# -----------------------------------------------------------------------------
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfstate.backup
terraform.tfvars
terraform.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
crash.log
crash.*.log

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
.docker/
docker-compose.override.yml

# -----------------------------------------------------------------------------
# IDE & Editor — VS Code
# .vscode/ user settings are machine-specific. Exception: shared settings
# like recommended extensions can optionally be committed (team preference).
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.code-workspace

# -----------------------------------------------------------------------------
# IDE & Editor — JetBrains (PyCharm, WebStorm, etc.)
# -----------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr

# -----------------------------------------------------------------------------
# IDE & Editor — Other
# -----------------------------------------------------------------------------
*.swp
*.swo
*~
.DS_Store          # macOS Finder metadata
Thumbs.db          # Windows thumbnail cache
ehthumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# OS-Generated Files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# -----------------------------------------------------------------------------
# Temporary / Misc
# -----------------------------------------------------------------------------
*.tmp
*.bak
*.orig
.cache/
tmp/
temp/
